# ========================================
# CẤU HÌNH AI AGENT NEWS BOT
# ========================================

# Telegram Bot Token (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chọn provider AI (darkapi/openai/groq/local)
AI_PROVIDER=darkapi

# --- Cấu hình DarkAPI (https://darkapi.dev) ---
DARKAPI_KEY=your_darkapi_key_here
DARKAPI_MODEL=laguna-s-2.1-free

# --- Cấu hình OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# --- Cấu hình Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# --- Cấu hình Local LLM (ggml/gguf) ---
LOCAL_MODEL_PATH=./models/model.gguf

# Danh sách nguồn tin RSS (mỗi nguồn cách nhau bằng dấu phẩy)
RSS_FEEDS=https://vnexpress.net/rss/thoisu,https://thanhnien.vn/rsspolitics,https://baotintuc.vn/en/rss

# Kênh Telegram để lấy tin (tùy chọn)
TELEGRAM_CHANNELS=

# Số lượng tin tối đa mỗi lần gửi
MAX_ARTICLES=5
