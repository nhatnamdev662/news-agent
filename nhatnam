#!/usr/bin/env bash
# nhatnam — khoi chay AI Agent News Bot
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV="${DIR}/.env"

getv() { grep -E "^$1=" "${ENV}" 2>/dev/null | head -1 | cut -d= -f2-; }

edit_env() {
    local name="$1" value="$2"
    if grep -q "^${name}=" "${ENV}" 2>/dev/null; then
        sed -i "s|^${name}=.*|${name}=${value}|" "${ENV}"
    else
        echo "${name}=${value}" >> "${ENV}"
    fi
}

# Quet danh sach model tu OpenCode API
scan_models() {
    local base_url="$1"
    curl -s --connect-timeout 8 --max-time 12 "${base_url}/models" 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    models = [m['id'] for m in data.get('data', []) if m.get('id')]
    for m in sorted(models):
        print(m)
except:
    pass
" 2>/dev/null
}

do_config() {
    [ -f "${ENV}" ] || touch "${ENV}"
    echo ""
    echo "╔══════════════════════════════════════════════╗"
    echo "║   ⚙️  CẤU HÌNH AI AGENT NEWS BOT            ║"
    echo "║   Nhấn Enter để giữ nguyên giá trị hiện tại ║"
    echo "╚══════════════════════════════════════════════╝"
    echo ""

    # --- 1. BOT TOKEN ---
    echo "━━━ 1. TELEGRAM BOT ━━━"
    cur_token="$(getv BOT_TOKEN)"
    read -p "   Token bot [${cur_token}]: " v
    edit_env "BOT_TOKEN" "${v:-${cur_token}}"
    echo ""

    # --- 2. AI PROVIDER ---
    echo "━━━ 2. AI PROVIDER ━━━"
    echo "   1) opencode  — không cần API key, tự scan model"
    echo "   2) custom    — cần API key + base URL"
    echo ""
    cur_prov="$(getv AI_PROVIDER)"
    cur_prov="${cur_prov:-opencode}"
    read -p "   Chọn [${cur_prov}]: " prov_input
    if [ -n "${prov_input}" ]; then
        case "${prov_input}" in
            1|opencode) prov="opencode" ;;
            2|custom)   prov="custom" ;;
            *)          prov="${prov_input}" ;;
        esac
    else
        prov="${cur_prov}"
    fi
    edit_env "AI_PROVIDER" "${prov}"
    echo "   ✅ Provider: ${prov}"
    echo ""

    # --- 3. Provider chi tiet ---
    if [ "${prov}" = "opencode" ]; then
        echo "━━━ 3. CHỌN MODEL (OpenCode) ━━━"
        echo "   Không cần API key — đang quét danh sách model..."
        echo ""

        cur_model="$(getv OPENCODE_MODEL)"
        models_text="$(scan_models "https://api.opencode.ai/v1")"

        if [ -n "${models_text}" ]; then
            # Hien danh sach va cho chon
            models=()
            while IFS= read -r line; do
                [ -n "$line" ] && models+=("$line")
            done <<< "${models_text}"
            count=${#models[@]}

            echo "   📋 Tìm thấy ${count} model:"
            echo "   ─────────────────────────────────"
            idx=1
            cur_idx=""
            for m in "${models[@]}"; do
                if [ "$m" = "${cur_model}" ]; then
                    echo "   ${idx}) ✅ ${m}  ← hiện tại"
                    cur_idx="${idx}"
                else
                    echo "   ${idx}) ${m}"
                fi
                idx=$((idx+1))
            done
            echo "   ─────────────────────────────────"
            default="${cur_idx:-1}"
            read -p "   Chọn model [${default}]: " choice
            if [ -z "${choice}" ]; then choice="${default}"; fi

            if [[ "${choice}" =~ ^[0-9]+$ ]] && [ "${choice}" -ge 1 ] && [ "${choice}" -le "${count}" ]; then
                chosen="${models[$((choice-1))]}"
            else
                chosen="${choice}"
            fi
            echo "   ✅ Model: ${chosen}"
            edit_env "OPENCODE_MODEL" "${chosen}"
        else
            echo "   ⚠️  Không quét được danh sách model."
            echo "   Nhập tay model name:"
            read -p "   Model [${cur_model}]: " v
            edit_env "OPENCODE_MODEL" "${v:-${cur_model}}"
        fi

    elif [ "${prov}" = "custom" ]; then
        echo "━━━ 3. CUSTOM PROVIDER ━━━"
        cur_key="$(getv CUSTOM_API_KEY)"
        cur_url="$(getv CUSTOM_API_URL)"
        cur_model="$(getv CUSTOM_MODEL)"

        read -p "   API Key [${cur_key}]: " v
        edit_env "CUSTOM_API_KEY" "${v:-${cur_key}}"

        read -p "   Base URL [${cur_url:-https://api.darkapi.dev/v1}]: " v
        edit_env "CUSTOM_API_URL" "${v:-${cur_url:-https://api.darkapi.dev/v1}}"

        read -p "   Model [${cur_model:-laguna-s-2.1-free}]: " v
        edit_env "CUSTOM_MODEL" "${v:-${cur_model:-laguna-s-2.1-free}}"
    fi
    echo ""

    # --- 4. Tùy chọn ---
    echo "━━━ 4. TÙY CHỌN ━━━"
    cur_admin="$(getv ADMIN_CHAT_ID)"
    read -p "   Admin Chat ID [${cur_admin}]: " v
    edit_env "ADMIN_CHAT_ID" "${v:-${cur_admin}}"

    cur_min="$(getv SCAN_MINUTES)"
    read -p "   Scan mỗi X phút [${cur_min:-5}]: " mins
    if [ -n "${mins}" ]; then
        edit_env "SCAN_MINUTES" "${mins}"
    fi
    echo ""

    # --- Summary ---
    echo "╔══════════════════════════════════════════════╗"
    echo "║  ✅ Đã lưu cấu hình!                        ║"
    echo "╚══════════════════════════════════════════════╝"
    echo ""
    if [ "${prov}" = "opencode" ]; then
        echo "   Model: $(getv OPENCODE_MODEL 2>/dev/null || echo '❌')"
    else
        echo "   Model: $(getv CUSTOM_MODEL 2>/dev/null || echo '❌')"
        echo "   API:   $(getv CUSTOM_API_URL 2>/dev/null || echo '❌')"
    fi
    echo ""
    echo "🚀 Chạy 'nhatnam' để khởi động"
    echo ""
}

do_start() {
    if ! python3 "${DIR}/validate.py"; then
        echo ""
        read -p "❓ Nhập/cập nhật cấu hình ngay? (y/N): " yn
        if [ "${yn}" = "y" ] || [ "${yn}" = "Y" ]; then
            do_config
            python3 "${DIR}/validate.py" || { echo "❌ Vẫn lỗi cấu hình."; exit 1; }
        else
            echo "💡 Chạy 'nhatnam config' khi sẵn sàng."
            exit 1
        fi
    fi
    echo "🚀 Khởi động AI Agent News Bot (Ctrl+C để tắt)..."
    cd "${DIR}"
    exec bash run.sh
}

case "${1:-start}" in
    config) do_config ;;
    start|"") do_start ;;
    *) echo "Cách dùng: nhatnam [start|config]" ;;
esac
