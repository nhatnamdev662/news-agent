#!/usr/bin/env bash
# nhatnam — khoi chay AI Agent News Bot
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV="${DIR}/.env"

getv() { grep -E "^$1=" "${ENV}" 2>/dev/null | head -1 | cut -d= -f2-; }

edit_env() {
    local name="$1" value="$2"
    if grep -q "^${name}=" "${ENV}" 2>/dev/null; then
        sed -i "s|^${name}=.*|${name}=${value}|" "${ENV}"
    else
        echo "${name}=${value}" >> "${ENV}"
    fi
}

# Quet danh sach model tu DarkAPI (hoac OpenAI-compatible endpoint)
scan_models() {
    local base_url="$1" api_key="$2"
    local auth_header=""
    if [ -n "${api_key}" ]; then
        auth_header="-H \"Authorization: Bearer ${api_key}\""
    fi
    curl -s --connect-timeout 8 --max-time 12 \
        -H "Authorization: Bearer ${api_key}" \
        -H "Accept: application/json" \
        "${base_url}/models" 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    models = [m['id'] for m in data.get('data', []) if m.get('id')]
    for m in sorted(models):
        print(m)
except:
    pass
" 2>/dev/null
}

do_config() {
    [ -f "${ENV}" ] || touch "${ENV}"
    echo ""
    echo "╔══════════════════════════════════════════════╗"
    echo "║   ⚙️  CẤU HÌNH AI AGENT NEWS BOT            ║"
    echo "║   Nhấn Enter để giữ nguyên giá trị hiện tại ║"
    echo "╚══════════════════════════════════════════════╝"
    echo ""

    # --- 1. BOT TOKEN ---
    echo "━━━ 1. TELEGRAM BOT ━━━"
    cur_token="$(getv BOT_TOKEN)"
    read -p "   Token bot [${cur_token}]: " v
    edit_env "BOT_TOKEN" "${v:-${cur_token}}"
    echo ""

    # --- 2. API KEY ---
    echo "━━━ 2. AI PROVIDER ━━━"
    echo "   Provider: Custom (OpenAI-compatible, vd DarkAPI)"
    echo ""
    cur_key="$(getv CUSTOM_API_KEY)"
    read -p "   API Key [${cur_key}]: " v
    edit_env "CUSTOM_API_KEY" "${v:-${cur_key}}"

    cur_url="$(getv CUSTOM_API_URL)"
    default_url="https://api.darkapi.dev/v1"
    read -p "   Base URL [${cur_url:-${default_url}}]: " v
    edit_env "CUSTOM_API_URL" "${v:-${cur_url:-${default_url}}}"
    echo ""

    # --- 3. CHON MODEL (tu dong quet) ---
    echo "━━━ 3. CHỌN MODEL ━━━"
    api_url="${v:-${cur_url:-${default_url}}}"
    api_key="${v:-${cur_key}}"
    cur_model="$(getv CUSTOM_MODEL)"

    echo "   Đang quét danh sách model từ ${api_url}..."
    echo ""
    models_text="$(scan_models "${api_url}" "${api_key}")"

    if [ -n "${models_text}" ]; then
        models=()
        while IFS= read -r line; do
            [ -n "$line" ] && models+=("$line")
        done <<< "${models_text}"
        count=${#models[@]}

        echo "   📋 Tìm thấy ${count} model:"
        echo "   ─────────────────────────────────"
        idx=1
        cur_idx=""
        for m in "${models[@]}"; do
            if [ "$m" = "${cur_model}" ]; then
                echo "   ${idx}) ✅ ${m}  ← hiện tại"
                cur_idx="${idx}"
            else
                echo "   ${idx}) ${m}"
            fi
            idx=$((idx+1))
        done
        echo "   ─────────────────────────────────"
        default="${cur_idx:-1}"
        read -p "   Chọn model [${default}]: " choice
        if [ -z "${choice}" ]; then choice="${default}"; fi

        if [[ "${choice}" =~ ^[0-9]+$ ]] && [ "${choice}" -ge 1 ] && [ "${choice}" -le "${count}" ]; then
            chosen="${models[$((choice-1))]}"
        else
            chosen="${choice}"
        fi
        echo "   ✅ Model: ${chosen}"
        edit_env "CUSTOM_MODEL" "${chosen}"
    else
        echo "   ⚠️  Không quét được danh sách model."
        echo "   Nhập tay model name (vd: laguna-s-2.1-free):"
        read -p "   Model [${cur_model:-laguna-s-2.1-free}]: " v
        edit_env "CUSTOM_MODEL" "${v:-${cur_model:-laguna-s-2.1-free}}"
    fi
    echo ""

    # --- 4. Tùy chọn ---
    echo "━━━ 4. TÙY CHỌN ━━━"
    cur_admin="$(getv ADMIN_CHAT_ID)"
    read -p "   Admin Chat ID (để trống = bỏ qua) [${cur_admin}]: " v
    edit_env "ADMIN_CHAT_ID" "${v:-${cur_admin}}"

    cur_min="$(getv SCAN_MINUTES)"
    read -p "   Scan mỗi X phút [${cur_min:-5}]: " mins
    if [ -n "${mins}" ]; then
        edit_env "SCAN_MINUTES" "${mins}"
    fi
    echo ""

    # --- Summary ---
    echo "╔══════════════════════════════════════════════╗"
    echo "║  ✅ Đã lưu cấu hình!                        ║"
    echo "╚══════════════════════════════════════════════╝"
    echo ""
    echo "   API Key:  $([ -n "$(getv CUSTOM_API_KEY)" ] && echo '✅' || echo '❌')"
    echo "   API URL:  $(getv CUSTOM_API_URL 2>/dev/null || echo '❌')"
    echo "   Model:    $(getv CUSTOM_MODEL 2>/dev/null || echo '❌')"
    echo ""
    echo "🚀 Chạy 'nhatnam' để khởi động"
    echo ""
}

do_start() {
    if ! python3 "${DIR}/validate.py"; then
        echo ""
        read -p "❓ Nhập/cập nhật cấu hình ngay? (y/N): " yn
        if [ "${yn}" = "y" ] || [ "${yn}" = "Y" ]; then
            do_config
            python3 "${DIR}/validate.py" || { echo "❌ Vẫn lỗi cấu hình."; exit 1; }
        else
            echo "💡 Chạy 'nhatnam config' khi sẵn sàng."
            exit 1
        fi
    fi
    echo "🚀 Khởi động AI Agent News Bot (Ctrl+C để tắt)..."
    cd "${DIR}"
    exec bash run.sh
}

case "${1:-start}" in
    config) do_config ;;
    start|"") do_start ;;
    *) echo "Cách dùng: nhatnam [start|config]" ;;
esac
